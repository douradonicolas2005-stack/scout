# SCOUT V1.1 — variáveis locais (copie para .env conforme necessário; NUNCA versionar segredos)
# Serviços vinculados a loopback (uso exclusivamente local)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Persistência (SQLite local)
# DATABASE_URL=sqlite:///absolute/path/to/scout/backend/data/scout.db

# Ollama (local, sob demanda; sem inferência automática na Foundation)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Scheduler (conservador; estado canônico no banco)
SCHEDULER_ENABLED=false
SCHEDULER_MAX_CONCURRENT_JOBS=1
