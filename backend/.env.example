# SCOUT backend (local-only, loopback)
APP_NAME=SCOUT API
APP_VERSION=0.1.0-foundation-v1.1
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
# Deixe vazio para usar backend/data/scout.db
DATABASE_URL=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Ollama (abstração/configuração; verificação sob demanda, sem inferência automática)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=5

# Scheduler (conservador; estado canônico no banco; Foundation A: desabilitado)
SCHEDULER_ENABLED=false
SCHEDULER_MAX_CONCURRENT_JOBS=1
